# 公開URL（招待URL・QRに使う）。末尾スラッシュなし
BASE_URL=https://lemon.example.com
# アプリの待ち受け（リバースプロキシからのみ接続させる）
HOST=127.0.0.1
PORT=3000
# SQLiteの保存先（永続ディスク上に置く）
DB_PATH=/var/lib/lemon-score/lemon-score.sqlite
# リバースプロキシ配下なら1（X-Forwarded-For を試行制限に使う）
TRUST_PROXY=1
# HTTPSでのみCookieを送る（ローカル開発時のみ0）
COOKIE_SECURE=1
# 入力上限・保存期限
MAX_COUNT=999
RETENTION_LOBBY_HOURS=24
RETENTION_ACTIVE_HOURS=72
RETENTION_FINISHED_DAYS=30
RECOVERY_REQUEST_MINUTES=10
CLEANUP_INTERVAL_MINUTES=10
# 結果テキストの日時表示
TIMEZONE=Asia/Tokyo
TIMEZONE_LABEL=日本時間
# 参加申請・復帰などの試行制限（1IPあたり毎分）
RATE_LIMIT_PER_MINUTE=60
