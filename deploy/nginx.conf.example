# nginx: 証明書は certbot 等で取得・自動更新する
# 招待トークンをアクセスログに残さないよう、パスを含まないログ形式にする
log_format lemon_nopath '$remote_addr [$time_local] "$request_method" $status $body_bytes_sent';

server {
    listen 443 ssl http2;
    server_name lemon.example.com;
    ssl_certificate     /etc/letsencrypt/live/lemon.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lemon.example.com/privkey.pem;

    access_log /var/log/nginx/lemon-score.access.log lemon_nopath;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}

server {
    listen 80;
    server_name lemon.example.com;
    return 301 https://$host$request_uri;
}
