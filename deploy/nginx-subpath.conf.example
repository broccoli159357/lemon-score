# 既存サイトの server { listen 443 ssl; ... } の中に追加して、
# https://example.com/lemon/ で公開する例。アプリ側は BASE_URL=https://example.com/lemon にする。
location = /lemon { return 301 /lemon/; }
location /lemon/ {
    # 末尾の / で /lemon を取り除いてアプリへ渡す
    proxy_pass http://127.0.0.1:3000/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    # 招待トークンがパスに入るため、この場所のアクセスログは取らない
    access_log off;
}
